{
  "$description": "Tokens de diseño exportados de la pantalla Catálogo de RENT-GO y sus componentes Navbar, Footer y Logo.",
  "$extensions": {
    "com.rent-go.source": [
      "src/index.css",
      "src/pages/Catalog.tsx",
      "src/components/Navbar.tsx",
      "src/components/Footer.tsx",
      "src/components/Logo.tsx"
    ],
    "com.rent-go.route": "/catalogo",
    "com.rent-go.generated": true
  },
  "color": {
    "$type": "color",
    "brand": {
      "navy": { "$value": "#0B1F33" },
      "blue": { "$value": "#1769AA" },
      "teal": { "$value": "#00B8A9" },
      "tealDark": { "$value": "#009E91" }
    },
    "neutral": {
      "white": { "$value": "#FFFFFF" },
      "background": { "$value": "#F5F7FA" },
      "ink": { "$value": "#17202A" },
      "muted": { "$value": "#667085" },
      "border": { "$value": "#E4E7EC" },
      "scrollbar": { "$value": "#C1CAD6" },
      "scrollbarHover": { "$value": "#97A3B4" }
    },
    "feedback": {
      "available": { "$value": "#12B76A" },
      "reserved": { "$value": "#F59E0B" },
      "rented": { "$value": "#1769AA" },
      "unavailable": { "$value": "#D92D20" }
    },
    "alpha": {
      "white10": { "$value": "rgba(255, 255, 255, 0.10)" },
      "white40": { "$value": "rgba(255, 255, 255, 0.40)" },
      "white50": { "$value": "rgba(255, 255, 255, 0.50)" },
      "white60": { "$value": "rgba(255, 255, 255, 0.60)" },
      "white70": { "$value": "rgba(255, 255, 255, 0.70)" },
      "white80": { "$value": "rgba(255, 255, 255, 0.80)" },
      "white90": { "$value": "rgba(255, 255, 255, 0.90)" },
      "navy10": { "$value": "rgba(11, 31, 51, 0.10)" },
      "transparent": { "$value": "transparent" }
    },
    "semantic": {
      "pageBackground": { "$value": "{color.neutral.background}" },
      "surface": { "$value": "{color.neutral.white}" },
      "textPrimary": { "$value": "{color.neutral.ink}" },
      "textSecondary": { "$value": "{color.neutral.muted}" },
      "textInverse": { "$value": "{color.neutral.white}" },
      "borderDefault": { "$value": "{color.neutral.border}" },
      "actionPrimary": { "$value": "{color.brand.teal}" },
      "actionPrimaryHover": { "$value": "{color.brand.tealDark}" },
      "actionSecondary": { "$value": "{color.brand.blue}" },
      "sectionDark": { "$value": "{color.brand.navy}" },
      "focus": { "$value": "{color.brand.teal}" },
      "disabledBackground": { "$value": "{color.neutral.border}" },
      "disabledForeground": { "$value": "{color.neutral.muted}" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Manrope",
          "system-ui",
          "sans-serif"
        ]
      }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "light": { "$value": 300 },
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "extrabold": { "$value": 800 }
    },
    "fontSize": {
      "$type": "dimension",
      "logoCaption": { "$value": "9px" },
      "specification": { "$value": "10px" },
      "xs": { "$value": "12px" },
      "sm": { "$value": "14px" },
      "base": { "$value": "16px" },
      "lg": { "$value": "18px" },
      "xl": { "$value": "20px" },
      "emptyStateIcon": { "$value": "24px" },
      "pageTitleMobile": { "$value": "30px" },
      "pageTitleDesktop": { "$value": "36px" }
    },
    "lineHeight": {
      "$type": "number",
      "none": { "$value": 1 },
      "tight": { "$value": 1.25 },
      "normal": { "$value": 1.5 },
      "relaxed": { "$value": 1.625 }
    },
    "letterSpacing": {
      "$type": "dimension",
      "tight": { "$value": "-0.025em" },
      "normal": { "$value": "0em" },
      "widest": { "$value": "0.1em" }
    },
    "textTransform": {
      "none": { "$type": "string", "$value": "none" },
      "uppercase": { "$type": "string", "$value": "uppercase" }
    },
    "styles": {
      "pageTitleMobile": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.fontFamily.sans}",
          "fontSize": "{typography.fontSize.pageTitleMobile}",
          "fontWeight": "{typography.fontWeight.extrabold}",
          "letterSpacing": "{typography.letterSpacing.normal}",
          "lineHeight": "{typography.lineHeight.tight}"
        }
      },
      "pageTitleDesktop": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.fontFamily.sans}",
          "fontSize": "{typography.fontSize.pageTitleDesktop}",
          "fontWeight": "{typography.fontWeight.extrabold}",
          "letterSpacing": "{typography.letterSpacing.normal}",
          "lineHeight": "{typography.lineHeight.tight}"
        }
      },
      "filterHeading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.fontFamily.sans}",
          "fontSize": "{typography.fontSize.xs}",
          "fontWeight": "{typography.fontWeight.bold}",
          "letterSpacing": "{typography.letterSpacing.widest}",
          "lineHeight": "{typography.lineHeight.normal}"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.fontFamily.sans}",
          "fontSize": "{typography.fontSize.sm}",
          "fontWeight": "{typography.fontWeight.regular}",
          "letterSpacing": "{typography.letterSpacing.normal}",
          "lineHeight": "{typography.lineHeight.normal}"
        }
      },
      "control": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.fontFamily.sans}",
          "fontSize": "{typography.fontSize.sm}",
          "fontWeight": "{typography.fontWeight.medium}",
          "letterSpacing": "{typography.letterSpacing.normal}",
          "lineHeight": "{typography.lineHeight.normal}"
        }
      },
      "button": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.fontFamily.sans}",
          "fontSize": "{typography.fontSize.xs}",
          "fontWeight": "{typography.fontWeight.semibold}",
          "letterSpacing": "{typography.letterSpacing.normal}",
          "lineHeight": "{typography.lineHeight.normal}"
        }
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "0_5": { "$value": "2px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "2_5": { "$value": "10px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "24": { "$value": "96px" }
  },
  "size": {
    "$type": "dimension",
    "hairline": { "$value": "1px" },
    "iconSm": { "$value": "14px" },
    "iconMd": { "$value": "16px" },
    "logoMark": { "$value": "32px" },
    "socialButton": { "$value": "36px" },
    "logoMarkLight": { "$value": "36px" },
    "emptyStateIcon": { "$value": "64px" },
    "navbarHeight": { "$value": "64px" },
    "catalogImageHeight": { "$value": "176px" },
    "filterSidebarWidth": { "$value": "240px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px" },
    "md": { "$value": "10px" },
    "lg": { "$value": "14px" },
    "xl": { "$value": "20px" },
    "full": { "$value": "9999px" }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "color": "rgba(0, 0, 0, 0.05)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "card": {
      "$value": [
        {
          "color": "rgba(11, 31, 51, 0.06)",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "4px",
          "spread": "0px"
        },
        {
          "color": "rgba(11, 31, 51, 0.08)",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "16px",
          "spread": "0px"
        }
      ]
    },
    "elevated": {
      "$value": {
        "color": "rgba(11, 31, 51, 0.14)",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "32px",
        "spread": "0px"
      }
    }
  },
  "blur": {
    "$type": "dimension",
    "backdropSm": { "$value": "4px" }
  },
  "opacity": {
    "$type": "number",
    "10": { "$value": 0.1 },
    "40": { "$value": 0.4 },
    "50": { "$value": 0.5 },
    "60": { "$value": 0.6 },
    "70": { "$value": 0.7 },
    "80": { "$value": 0.8 },
    "90": { "$value": 0.9 },
    "100": { "$value": 1 }
  },
  "layout": {
    "container": {
      "$type": "dimension",
      "xs": { "$value": "320px" },
      "7xl": { "$value": "1280px" }
    },
    "breakpoint": {
      "$type": "dimension",
      "sm": { "$value": "640px" },
      "md": { "$value": "768px" },
      "lg": { "$value": "1024px" },
      "xl": { "$value": "1280px" }
    },
    "zIndex": {
      "navbar": { "$type": "number", "$value": 50 }
    },
    "grid": {
      "catalogMobileColumns": { "$type": "number", "$value": 1 },
      "catalogTabletColumns": { "$type": "number", "$value": 2 },
      "catalogDesktopColumns": { "$type": "number", "$value": 3 },
      "specificationColumns": { "$type": "number", "$value": 4 },
      "footerDesktopColumns": { "$type": "number", "$value": 5 }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "150ms" },
      "slow": { "$value": "300ms" },
      "image": { "$value": "500ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.4, 0, 0.2, 1] }
    },
    "transform": {
      "imageHoverScale": { "$type": "number", "$value": 1.05 }
    }
  },
  "component": {
    "navbar": {
      "height": { "$type": "dimension", "$value": "{size.navbarHeight}" },
      "background": { "$type": "color", "$value": "{color.semantic.sectionDark}" },
      "contentMaxWidth": { "$type": "dimension", "$value": "{layout.container.7xl}" },
      "horizontalPadding": { "$type": "dimension", "$value": "{spacing.6}" }
    },
    "pageHeader": {
      "background": { "$type": "color", "$value": "{color.semantic.sectionDark}" },
      "paddingTop": { "$type": "dimension", "$value": "{spacing.24}" },
      "paddingBottom": { "$type": "dimension", "$value": "{spacing.12}" },
      "horizontalPadding": { "$type": "dimension", "$value": "{spacing.6}" },
      "contentMaxWidth": { "$type": "dimension", "$value": "{layout.container.7xl}" }
    },
    "control": {
      "background": { "$type": "color", "$value": "{color.semantic.surface}" },
      "foreground": { "$type": "color", "$value": "{color.semantic.textPrimary}" },
      "border": { "$type": "color", "$value": "{color.semantic.borderDefault}" },
      "borderFocus": { "$type": "color", "$value": "{color.semantic.focus}" },
      "radius": { "$type": "dimension", "$value": "{radius.xl}" },
      "paddingInline": { "$type": "dimension", "$value": "{spacing.4}" },
      "paddingBlock": { "$type": "dimension", "$value": "{spacing.3}" }
    },
    "filterPanel": {
      "widthDesktop": { "$type": "dimension", "$value": "{size.filterSidebarWidth}" },
      "background": { "$type": "color", "$value": "{color.semantic.surface}" },
      "border": { "$type": "color", "$value": "{color.semantic.borderDefault}" },
      "radius": { "$type": "dimension", "$value": "{radius.xl}" },
      "padding": { "$type": "dimension", "$value": "{spacing.6}" },
      "sectionGap": { "$type": "dimension", "$value": "{spacing.6}" },
      "optionGap": { "$type": "dimension", "$value": "{spacing.2}" },
      "accent": { "$type": "color", "$value": "{color.semantic.actionPrimary}" }
    },
    "catalogCard": {
      "background": { "$type": "color", "$value": "{color.semantic.surface}" },
      "border": { "$type": "color", "$value": "{color.semantic.borderDefault}" },
      "radius": { "$type": "dimension", "$value": "{radius.xl}" },
      "contentPadding": { "$type": "dimension", "$value": "{spacing.5}" },
      "imageHeight": { "$type": "dimension", "$value": "{size.catalogImageHeight}" },
      "shadow": { "$type": "shadow", "$value": "{shadow.card}" },
      "shadowHover": { "$type": "shadow", "$value": "{shadow.elevated}" }
    },
    "statusBadge": {
      "foreground": { "$type": "color", "$value": "{color.semantic.textInverse}" },
      "radius": { "$type": "dimension", "$value": "{radius.full}" },
      "paddingInline": { "$type": "dimension", "$value": "{spacing.2_5}" },
      "paddingBlock": { "$type": "dimension", "$value": "{spacing.1}" },
      "availableBackground": { "$type": "color", "$value": "{color.feedback.available}" },
      "reservedBackground": { "$type": "color", "$value": "{color.feedback.reserved}" },
      "rentedBackground": { "$type": "color", "$value": "{color.feedback.rented}" },
      "unavailableBackground": { "$type": "color", "$value": "{color.feedback.unavailable}" }
    },
    "buttonPrimary": {
      "background": { "$type": "color", "$value": "{color.semantic.actionPrimary}" },
      "backgroundHover": { "$type": "color", "$value": "{color.semantic.actionPrimaryHover}" },
      "foreground": { "$type": "color", "$value": "{color.semantic.textInverse}" },
      "radius": { "$type": "dimension", "$value": "{radius.lg}" },
      "paddingBlock": { "$type": "dimension", "$value": "{spacing.2_5}" }
    },
    "buttonDisabled": {
      "background": { "$type": "color", "$value": "{color.semantic.disabledBackground}" },
      "foreground": { "$type": "color", "$value": "{color.semantic.disabledForeground}" },
      "radius": { "$type": "dimension", "$value": "{radius.lg}" },
      "paddingBlock": { "$type": "dimension", "$value": "{spacing.2_5}" }
    },
    "emptyState": {
      "iconSize": { "$type": "dimension", "$value": "{size.emptyStateIcon}" },
      "verticalPadding": { "$type": "dimension", "$value": "{spacing.24}" }
    },
    "footer": {
      "background": { "$type": "color", "$value": "{color.semantic.sectionDark}" },
      "foreground": { "$type": "color", "$value": "{color.semantic.textInverse}" },
      "contentMaxWidth": { "$type": "dimension", "$value": "{layout.container.7xl}" },
      "horizontalPadding": { "$type": "dimension", "$value": "{spacing.6}" },
      "verticalPadding": { "$type": "dimension", "$value": "{spacing.16}" }
    }
  },
  "asset": {
    "vehicleBmw320i": {
      "$type": "string",
      "$value": "https://images.unsplash.com/photo-1645400379459-f6fd3d963fd4?w=600&h=400&fit=crop&auto=format"
    },
    "vehicleMercedesGlc300": {
      "$type": "string",
      "$value": "https://images.unsplash.com/photo-1568723331958-ce8c291349e7?w=600&h=400&fit=crop&auto=format"
    },
    "vehicleToyotaCorolla": {
      "$type": "string",
      "$value": "https://images.unsplash.com/photo-1550242499-b5171f56de56?w=600&h=400&fit=crop&auto=format"
    },
    "vehicleFerrari458Italia": {
      "$type": "string",
      "$value": "https://images.unsplash.com/photo-1627667928346-5fc86d099a5c?w=600&h=400&fit=crop&auto=format"
    },
    "vehicleBmwX5": {
      "$type": "string",
      "$value": "https://images.unsplash.com/photo-1617814086906-d847a8bc6fca?w=600&h=400&fit=crop&auto=format"
    },
    "vehicleHyundaiI30": {
      "$type": "string",
      "$value": "https://images.unsplash.com/photo-1672024110512-f7028b49db28?w=600&h=400&fit=crop&auto=format"
    },
    "vehicleFordF150Raptor": {
      "$type": "string",
      "$value": "https://images.unsplash.com/photo-1606590526453-9b8ee4569a70?w=600&h=400&fit=crop&auto=format"
    },
    "vehicleTeslaModel3": {
      "$type": "string",
      "$value": "https://images.unsplash.com/photo-1680542993889-078ce9c8538a?w=600&h=400&fit=crop&auto=format"
    }
  }
}
