Rel(spa, devolucionCtrl, "Registra devolución")
Rel(spa, pagoCtrl, "Cobra factura")
Rel(mwRol, entregaCtrl, "Guarda coordinador,cajero,administrador")
Rel(mwRol, devolucionCtrl, "Guarda coordinador,cajero,administrador")
Rel(mwRol, pagoCtrl, "Guarda coordinador,cajero,administrador")
Rel(authCtrl, acciones, "RegistrarCliente / IniciarSesion")
Rel(catalogoCtrl, acciones, "ListarCatalogoVehiculos")
Rel(reservaCtrl, acciones, "CrearReserva / ConfirmarReserva / ListarReservas")
